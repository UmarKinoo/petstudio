{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thepetstudio.local/schemas/hero-home.json",
  "title": "Pet Studio widget: hero-home",
  "type": "object",
  "properties": {
    "video_desktop": { "$ref": "_common.json#/$defs/media" },
    "video_mobile": { "$ref": "_common.json#/$defs/media" },
    "headline": { "type": "string" },
    "headline_accent": { "type": "string" },
    "supporting_copy": { "type": "string" },
    "headline_words": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "word": { "type": "string" },
              "subtitle": { "type": "string" }
            },
            "required": ["word"]
          }
        ]
      }
    },
    "hours_title": { "type": "string" },
    "hours_text": { "type": "string" },
    "cta_text": { "type": "string" },
    "cta_link": { "$ref": "_common.json#/$defs/link" },
    "cta2_text": { "type": "string" },
    "cta2_link": { "$ref": "_common.json#/$defs/link" }
  }
}
